{
 "version": 1,
 "rateMs": 10000,
 "heuristicHoldMs": 8000,
 "cases": [
  {
   "name": "needs-answer is announced at once",
   "steps": [
    {
     "step": {
      "type": "event",
      "now": 1000,
      "event": {
       "sessionId": "session-a",
       "state": "needs-answer",
       "since": 1000,
       "turn": 1,
       "exact": false
      }
     },
     "expect": [
      {
       "sessionId": "session-a",
       "turn": 1,
       "kind": "needs-answer",
       "exact": false,
       "text": "답이 필요합니다",
       "at": 1000
      }
     ]
    }
   ]
  },
  {
   "name": "an exact turn end says the work finished",
   "steps": [
    {
     "step": {
      "type": "event",
      "now": 5000,
      "event": {
       "sessionId": "session-a",
       "state": "turn-finished",
       "since": 5000,
       "turn": 2,
       "exact": true
      }
     },
     "expect": [
      {
       "sessionId": "session-a",
       "turn": 2,
       "kind": "turn-finished",
       "exact": true,
       "text": "작업이 끝났습니다",
       "at": 5000
      }
     ]
    }
   ]
  },
  {
   "name": "a heuristic turn end waits 8 s and never claims done",
