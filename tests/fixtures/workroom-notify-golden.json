    {
     "step": {
      "type": "event",
      "now": 1000,
      "event": {
       "sessionId": "session-a",
       "state": "turn-finished",
       "since": 1000,
       "turn": 1,
       "exact": false
      }
     },
     "expect": []
    },
    {
     "step": {
      "type": "tick",
      "now": 8999
     },
     "expect": []
    },
    {
     "step": {
      "type": "tick",
      "now": 9000
     },
     "expect": [
      {
       "sessionId": "session-a",
       "turn": 1,
       "kind": "turn-finished",
       "exact": false,
       "text": "응답이 멈췄습니다 · 확인해 보세요",
       "at": 9000
      }
     ]
    },
    {
     "step": {
      "type": "tick",
      "now": 20000
     },
     "expect": []
    }
   ]
  },
