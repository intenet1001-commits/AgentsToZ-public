{
  "name": "@agentstoz/runtime-sdk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/types/packages/runtime-sdk/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/types/packages/runtime-sdk/client.d.ts", "import": "./dist/client.js" }
  },
  "engines": { "bun": ">=1.3.14" },
  "peerDependencies": { "@tauri-apps/api": "^2.10.1" },
  "devDependencies": { "typescript": "^5", "@types/bun": "latest" },
  "scripts": {
    "build": "bun build packages/runtime-sdk/index.ts --target=bun --outdir=dist && bun build packages/runtime-sdk/client.ts --target=browser --external=@tauri-apps/api/core --outdir=dist && tsc -p tsconfig.json"
  }
}
