+                breathe.duration = 1.8
+                breathe.timingFunction = CAMediaTimingFunction(name: .easeOut)
+                breathe.repeatCount = .infinity
+                breathe.isRemovedOnCompletion = false
+                ring.add(breathe, forKey: "breathe")
