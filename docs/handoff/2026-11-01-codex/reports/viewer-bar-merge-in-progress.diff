+                ink = NSColor.black.withAlphaComponent(0.86)
+            case .quiet:
+                fill = NSColor.white.withAlphaComponent(pressed ? 0.24 : hovering ? 0.18 : 0.1)
+                ink = NSColor.white.withAlphaComponent(0.92)
+            case .stop:
