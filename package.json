{
  "name": "AgentsToZ_byCS",
  "type": "module",
  "private": true,
  "description": "로컬 개발 포트·프로젝트 관리 앱 (Tauri + React + Bun + Vercel Portal)",
  "author": "CS & Company",
  "homepage": "https://github.com/intenet1001-commits/AgentsToZ-public",
  "repository": {
    "type": "git",
    "url": "https://github.com/intenet1001-commits/AgentsToZ-public.git"
  },
  "scripts": {
    "dev": "bun dev.ts",
    "api": "bun api-server.ts",
    "start": "bun dev.ts",
    "build": "vite build",
    "build:sidecar": "bun build-sidecar.ts",
    "build:macos-runtime-native": "bun build-macos-runtime-native.ts",
    "build:macos-runtime-native:production": "bun build-macos-runtime-native-production.ts",
    "build:macos-runtime-app:production": "bun build-macos-runtime-production-app.ts",
    "build:macos-app:developer-id-base": "bun build-macos-developer-id-base.ts",
    "inspect:macos-runtime-production": "bun inspect-macos-runtime-production.ts",
    "benchmark:codex-conversation": "bun benchmark-codex-conversation.ts --live",
    "typecheck": "tsc --noEmit",
    "test": "bun test --cwd tests --max-concurrency=1",
    "test:rust": "bun run build:sidecar && cd src-tauri && cargo test",
    "verify": "bun run typecheck && bun run test && bun run test:rust",
    "test:resources": "bun test --cwd tests --max-concurrency=1 frontend-observation-lifecycle.test.ts project-memory-journal-cache.test.ts session-transcript-stream.test.ts session-transcript.test.ts what-i-said-transcript-collector.test.ts terminal-resource-lifecycle.test.ts ai-terminal-scheduling.test.ts terminal-memory-queue.test.ts memory-save-store.test.ts memory-save-observation.test.ts memory-save-incremental-observation.test.ts memory-observation-coordinator.test.ts memory-observation-status.test.ts auto-save-policy-v2.test.ts memory-save-disk-admission.test.ts memory-emergency-reserve.test.ts memory-save-host-commit.test.ts memory-save-input-store.test.ts memory-save-input-materializer.test.ts memory-save-input-key-provider.test.ts memory-save-key-lifecycle.test.ts memory-save-key-management.test.ts memory-save-executor.test.ts memory-save-dispatcher.test.ts memory-save-dispatch-api.test.ts memory-save-selection.test.ts memory-save-provider.test.ts memory-save-automatic-host.test.ts memory-save-maintenance.test.ts project-memory-run-with-timeout.test.ts remote-control-lan-resource.test.ts remote-control-transport-integration.test.ts codex-auto-remember-project-resolver.test.ts local-api-slow-startup.test.ts worktree-port-discovery.test.ts",
    "publish": "bun scripts/publish.ts",
    "build:portal": "vite build --config vite.portal.config.ts",
    "build:guide": "vite build --config vite.guide.config.ts",
    "deploy:guide": "bun scripts/deploy-public-guide.ts",
    "deploy:guide:dry-run": "bun scripts/deploy-public-guide.ts --dry-run",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "bun run build:sidecar && tauri dev",
    "update-version": "bun update-version.ts",
    "fix-dmg": "bun fix-dmg.ts",
    "tauri:build": "bun build-macos.ts",
    "tauri:build:dmg": "bun build-macos.ts --dmg",
    "tauri:build:win": "bun build-win.ts",
    "test:smoke": "node tests/smoke.mjs",
    "test:macos-runtime-native": "bun build-macos-runtime-native.ts --test-only",
    "test:macos-runtime-native:repeat": "bun run build:macos-runtime-native && bun test-macos-runtime-native-repeat.ts",
    "test:macos-runtime-production-sources": "bun test-macos-runtime-production-sources.ts",
    "test:smoke:vercel": "TARGET=vercel node tests/smoke.mjs",
    "test:smoke:mobile": "VIEWPORT=mobile TARGET=vercel node tests/smoke.mjs",
    "test:performance:web": "node tests/perf-measure.mjs",
    "test:windows:e2e": "tsx tests/windows-e2e.spec.ts",
    "install:api-agent": "bash scripts/install-api-launch-agent.sh",
    "sdk:export": "bun export-runtime-sdk.ts",
    "test:ios": "bun mobile/ios/scripts/check-native.ts",
    "preflight:ios": "bun mobile/ios/scripts/preflight.ts",
    "install:ios:development": "bun mobile/ios/scripts/install-development.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "2.10.1",
    "@types/bun": "latest",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@wdio/cli": "9.31.2",
    "@wdio/local-runner": "9.31.2",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/tauri-service": "1.3.0",
    "autoprefixer": "10.5.4",
    "playwright": "^1.62.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.12",
    "vite": "7.3.6",
    "webdriverio": "9.31.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "picomatch": "2.3.2",
    "postcss": "8.5.26",
    "rollup": "4.62.5",
    "serialize-javascript": "7.1.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.555.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  }
}
