# Vercel 빌드 시 주입되는 환경변수 (로컬 개발에선 선택).
# `vercel env add <KEY>` 로 등록하거나 Vercel 대시보드의 Environment Variables 에 추가.

# 공개 설치 설명서 전용 주소. 개인 포털과 반드시 분리하세요.
# 공개 README·설치 현황판·AWS 스크립트 링크에 사용됩니다.
VITE_ONBOARDING_GUIDE_URL=https://agentstoz-guide.vercel.app

# 개인용 포털 주소(선택). 공개 저장소에 실제 값을 커밋하지 마세요.
# 앱 자동 배포가 portal.json에 저장한 주소가 있으면 그 값을 먼저 사용합니다.
# 저장 주소와 이 값이 모두 없을 때만 "포털 열기/새 단말 등록 링크"가 비활성화되며 로컬·Supabase 동기화는 계속 작동합니다.
VITE_PORTAL_URL=

# 개인 포털이 localhost API의 제한된 장기기억 경로를 사용할 때만 서버 실행 환경에 설정하세요.
# 콤마로 여러 HTTPS origin을 넣을 수 있으며, 기본값은 빈 목록(외부 origin 허용 없음)입니다.
PORTMGR_PORTAL_INTEGRATION_ORIGINS=

# Supabase 프로젝트 URL — https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon public key — supabase 대시보드 → Project Settings → API
VITE_SUPABASE_ANON_KEY=

# (선택) 공개 설치판의 VOC 수집 Edge Function. 비밀값이 아닙니다.
# 앱 동기화·장기기억 Supabase와 분리한 별도 공개 수신 프로젝트만 사용하세요.
# 미설정 또는 off이면 원격 전송 없이 사용자 PC에만 저장됩니다.
# VITE_VOC_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/submit-voc
VITE_VOC_ENDPOINT=

# 포털 회원 권한의 단일 정본은 Supabase public.portmgr_allowed_members입니다.
# 포털은 로그인 후 portmgr_is_member()로 확인하며 build-time 이메일 목록은 사용하지 않습니다.

# (선택) api-server의 GitHub Actions 대상 포크 정보. 둘을 항상 함께 설정하세요.
# 둘 다 비우면 credential 없는 VITE_REPO_URL, 그다음 현재 checkout의 origin을 사용합니다.
# 어느 것도 안전하게 확인되지 않으면 GitHub Actions 버튼은 요청을 보내지 않습니다.
PORTMGR_GITHUB_OWNER=
PORTMGR_GITHUB_REPO=
PORTMGR_GITHUB_WORKFLOW=

# (선택) SetupWizard의 git clone / Fork 링크가 가리킬 저장소.
# 본인 포크가 있으면 그 공개 URL을 넣으세요. 미설정 시 공개 AgentsToZ-public 소스를 사용합니다.
VITE_REPO_URL=
