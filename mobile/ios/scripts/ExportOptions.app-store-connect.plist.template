<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- REVIEW TEMPLATE ONLY. Not consumed by archive-unsigned.ts or verify-archive.ts.
     Replace the team placeholder only after choosing the authorized Apple account.
     Requires a separately signed, validated iOS distribution archive. Never use the
     unsigned rehearsal as an installable/export-ready artifact. destination=export
     deliberately does not upload. No tool here invokes xcodebuild -exportArchive. -->
<plist version="1.0"><dict>
  <key>method</key><string>app-store-connect</string>
  <key>destination</key><string>export</string>
  <key>teamID</key><string>REPLACE_WITH_APPROVED_APPLE_TEAM_ID</string>
  <key>signingStyle</key><string>automatic</string>
  <key>manageAppVersionAndBuildNumber</key><false/>
  <key>uploadSymbols</key><false/>
</dict></plist>
